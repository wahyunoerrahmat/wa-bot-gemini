# Google Gemini API Key
# Dapatkan API Key dari https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (Contoh: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Instruksi Sistem / Peran Default Bot
SYSTEM_INSTRUCTION="Kamu adalah asisten cerdas WhatsApp yang ramah, membantu, serta merespon dengan cepat dan tepat dalam Bahasa Indonesia."

# Mode Filter Pengoperasian Bot:
# 'all'            -> Merespon semua chat pribadi & grup (Default)
# 'groups_only'    -> Hanya merespon di grup WhatsApp
# 'private_only'   -> Hanya merespon di chat pribadi
# 'whitelist_only' -> Hanya merespon kontak / grup yang terdaftar di ALLOWED_CHATS
BOT_MODE=all

# Daftar ID Chat/Grup/Nomor yang diizinkan (dipisahkan dengan koma)
# Anda bisa mengetahui ID chat/grup dengan mengirim perintah '!id' ke bot
# Contoh: ALLOWED_CHATS=6281234567890@c.us,120363123456789012@g.us
ALLOWED_CHATS=
